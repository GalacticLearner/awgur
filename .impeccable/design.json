      "css": ".ds-field{font-family:'Public Sans',sans-serif;display:flex;flex-direction:column;gap:8px;font-size:14px;font-weight:600;color:var(--ink,#193b36)}.ds-field input{font-family:'Public Sans',sans-serif;min-height:48px;width:100%;padding:12px;background:var(--surface,#fffef8);color:var(--ink,#193b36);border:1px solid var(--line,#ccd5cb);border-radius:8px;font-size:16px;caret-color:var(--green,#17594e)}.ds-field input::placeholder{color:#576d65}.ds-field input:focus-visible{outline:3px solid var(--green,#17594e);outline-offset:3px}"
    },
    {
      "name": "Planned Status",
      "kind": "chip",
      "refersTo": "chip-planned",
      "description": "A factual status label; not an interactive control.",
      "html": "<span class=\"ds-chip\">Planned</span>",
      "css": ".ds-chip{font-family:'Public Sans',sans-serif;display:inline-flex;align-items:center;gap:5px;font-size:11px;line-height:1.3;font-weight:600;border-radius:4px;padding:5px 7px;background:#f3e9cb;color:#6f4b10}"
    },
    {
      "name": "Work Record",
      "kind": "card",
      "refersTo": "record-row",
      "description": "A linked ruled record rather than an enclosed card.",
      "html": "<a href=\"#\" class=\"ds-record\"><span>CMWSSB</span><h3>Water main replacement</h3><p>Planned · 15–22 Oct 2026</p></a>",
      "css": ".ds-record{font-family:'Public Sans',sans-serif;display:block;min-height:48px;text-decoration:none;padding:16px 0 18px;color:var(--ink,#193b36);border-bottom:1px solid var(--line,#ccd5cb)}.ds-record:hover{background:#eff4e9}.ds-record:focus-visible{outline:3px solid var(--green,#17594e);outline-offset:3px}.ds-record span{font-size:12px;font-weight:600;color:var(--muted,#49645f)}.ds-record h3{font-size:16px;font-weight:700;line-height:1.35;margin:8px 0}.ds-record p{font-size:12px;color:var(--muted,#49645f);margin:0}"
    },
    {
      "name": "Main Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Named destinations with an active green paper treatment.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Street</a><a href=\"#\">Review</a><a href=\"#\">About</a></nav>",
      "css": ".ds-nav{font-family:'Public Sans',sans-serif;display:flex;gap:8px;background:var(--paper,#f6f4eb);padding:6px 12px;border-top:1px solid var(--line,#ccd5cb)}.ds-nav a{display:flex;align-items:center;justify-content:center;flex:1;min-height:52px;border-radius:8px;font-size:11px;text-decoration:none;color:var(--muted,#49645f)}.ds-nav a[aria-current]{background:#deeadc;color:#174d40;font-weight:700}.ds-nav a:focus-visible{outline:3px solid var(--green,#17594e);outline-offset:3px}"
    },
    {
      "name": "Clock Risk Record",
      "kind": "custom",
      "description": "Ruled explanation with a smaller method note.",
      "html": "<section class=\"ds-forecast\"><h3>Clock Risk · finish forecast</h3><p>No finish forecast: <strong>3 comparable completed works</strong> in this demo ledger; at least 9 are needed.</p><p class=\"ds-note\">Synthetic history. Conditional on exchangeable slips.</p></section>",
      "css": ".ds-forecast{font-family:'Public Sans',sans-serif;padding:20px 0;border-top:1px solid var(--line,#ccd5cb);color:var(--ink,#193b36)}.ds-forecast h3{font-size:17px;line-height:1.2;margin:0 0 10px}.ds-forecast p{font-size:14px;line-height:1.6;max-width:70ch;margin:0 0 16px}.ds-forecast .ds-note{font-size:12px;color:var(--muted,#49645f)}"
    }
  ],
  "narrative": {
    "northStar": "Civic street atlas",
    "overview": "A civic street atlas: warm paper, dark green ink, forest actions, amber schedule notes and rust red clash warnings. Public Sans, ruled lists and labelled records make public responsibility readable. The voice is plain and factual; the public name is lowercase awgur.\n\nThe reusable signature is a map connected to an expandable street record. The ledger feeds the decision: dates, agency, restoration responsibility and findings retain their context. This is a working civic record with compact supporting notes, rather than a marketing presentation.",
    "keyCharacteristics": [
      "Paper and green civic materials.",
      "Ruled records instead of nested cards.",
      "Locally bundled Public Sans.",
      "Map and sheet share selection.",
      "Text and icons accompany status."
    ],
    "rules": [
      {
        "name": "The Status Has Words Rule",
        "body": "Color accompanies a named status or finding; it never carries the meaning alone.",
        "section": "colors"
      },
      {
        "name": "The Record First Rule",
        "body": "Keep titles, agency, dates and evidence legible before adding visual emphasis.",
        "section": "typography"
      },
      {
        "name": "The Ruled Record Rule",
        "body": "Use lines and spacing for ordinary record grouping; reserve floating depth for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep awgur lowercase and use plain factual labels.",
      "Do retain agency, dates and responsibility in ruled records.",
      "Do pair status color with text and an SVG icon where used.",
      "Do provide recovery text for empty, loading, missing and error states.",
      "Do use the established 48px control floor, visible focus and safe-area insets.",
      "Do remove transitions when reduced motion is requested."
    ],
    "donts": [
      "Don't add marketing heroes, decorative imagery, gradients or nested cards.",
      "Don't replace the atlas and ledger language with a new aesthetic.",
      "Don't express a warning or forecast uncertainty through color alone.",
      "Don't inherit compact landscape control exceptions as a new control standard."
    ]
  }
}
